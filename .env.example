# Slack Bot Token (xoxb-...)
# Required scopes: chat:write, im:history, im:read, reactions:write
SLACK_BOT_TOKEN=

# Slack App-Level Token (xapp-...)
# Required scope: connections:write
SLACK_APP_TOKEN=

# Claude CLI timeout in milliseconds (default: 300000 = 5 minutes)
# CLAUDE_TIMEOUT=300000

# Comma-separated base directories for project discovery
# Used by "project set <name>" to fuzzy-find project folders
# PROJECT_DIRS=~/Files/Github,~/Projects

# Web dashboard port (default: 3141)
# DASHBOARD_PORT=3141

# For channel support, add these OAuth scopes: channels:history, groups:history
# And event subscriptions: message.channels, message.groups
